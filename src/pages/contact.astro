 ---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = "jzounkimba@gmail.com";
const tel1 = "+229 0197592493";
const tel2 = "+229 0149671096";
const whatsapp = "https://wa.me/2290197592493";
const linkedin = "https://linkedin.com/in/joseph-mahukpéhou-zounkimba-b6a20b374";
---
<BaseLayout title="Contact — ZOUNKIMBA Joseph Mahukpéhou" description="Contactez-moi pour vos projets de communication digitale et sportive">
  <section class="py-10 max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold text-brand-dark mb-8">Contact</h1>

    <div class="grid sm:grid-cols-2 gap-4 mb-10 text-sm">
      <a href={`mailto:${email}`} class="bg-white rounded-lg shadow p-4 hover:shadow-md">📧 {email}</a>
      <a href={`tel:${tel1}`} class="bg-white rounded-lg shadow p-4 hover:shadow-md">📞 {tel1}</a>
      <a href={whatsapp} target="_blank" class="bg-white rounded-lg shadow p-4 hover:shadow-md">💬 WhatsApp</a>
      <a href={linkedin} target="_blank" class="bg-white rounded-lg shadow p-4 hover:shadow-md">🔗 LinkedIn</a>
    </div>

    <h2 class="text-xl font-bold text-brand-dark mb-4">Envoyez-moi un message</h2>
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-4">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden"><label>Ne pas remplir : <input name="bot-field" /></label></p>

      <div>
        <label class="block text-sm font-medium text-brand-dark mb-1">Nom</label>
        <input type="text" name="nom" required class="w-full border border-brand/20 rounded px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium text-brand-dark mb-1">Email</label>
        <input type="email" name="email" required class="w-full border border-brand/20 rounded px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium text-brand-dark mb-1">Objet</label>
        <input type="text" name="objet" required class="w-full border border-brand/20 rounded px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium text-brand-dark mb-1">Message</label>
        <textarea name="message" required rows="5" class="w-full border border-brand/20 rounded px-3 py-2"></textarea>
      </div>
      <button type="submit" class="bg-brand-dark text-white px-6 py-2 rounded">Envoyer</button>
    </form>
  </section>
</BaseLayout>
